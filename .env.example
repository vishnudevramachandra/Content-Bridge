# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- WordPress ---
WORDPRESS_PORT=8080
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=changeme
WORDPRESS_DB_ROOT_PASSWORD=changeme_root

# --- Adminer (DB browser, dev-only) ---
ADMINER_PORT=8081

# --- WordPress seed script (wp-content/seed/seed.sh), dev-only ---
# Creates the wp-admin account on first run via `wp core install`.
WP_TITLE=Sentinel Industrial Supply
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme_admin
WP_ADMIN_EMAIL=admin@example.com

# --- Strapi ---
STRAPI_PORT=1337
STRAPI_DB_CLIENT=sqlite
STRAPI_DB_FILENAME=.tmp/data.db

# --- Strapi secrets ---
# Generate fresh ones with e.g.:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS needs 2-4 comma-separated values; the rest are single values.
STRAPI_APP_KEYS=changeme1,changeme2,changeme3,changeme4
STRAPI_API_TOKEN_SALT=changeme
STRAPI_ADMIN_JWT_SECRET=changeme
STRAPI_JWT_SECRET=changeme
STRAPI_TRANSFER_TOKEN_SALT=changeme
STRAPI_ENCRYPTION_KEY=changeme

# --- Strapi admin account, dev-only ---
STRAPI_ADMIN_EMAIL=admin@example.com
STRAPI_ADMIN_PASSWORD=changeme_admin
