{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Catalog counterpart to the WordPress marketing content — what the Discovery/Mapping agents populate and cross-reference against related_product_ids."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "legacyId": {
      "type": "integer",
      "unique": true
    },
    "description": {
      "type": "blocks"
    },
    "price": {
      "type": "decimal"
    },
    "certifications": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::certification.certification",
      "inversedBy": "products"
    },
    "standards": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::standard.standard",
      "inversedBy": "products"
    }
  }
}
